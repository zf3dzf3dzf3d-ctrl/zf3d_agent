import json, collections
p = r'F:\朱峰社区智能体无限_新版本\朱峰社区智能体无限_5.8.0\server\data\traces\trace-20261031.jsonl'
fail = collections.Counter()
lines = 0
with open(p, encoding='utf-8', errors='replace') as f:
    for line in f:
        lines += 1
        if 'run_code' not in line: continue
        try: d = json.loads(line)
        except: continue
        s = json.dumps(d, ensure_ascii=False)
        if 'exit_code": 1' in s or '运行失败' in s:
            # 提取 code 参数片段
            txt = s
            i = txt.find('"code"')
            snippet = txt[i:i+120] if i>=0 else txt[:120]
            fail[snippet] += 1
print('总行数', lines)
for k, v in fail.most_common(10):
    print(v, '|', k[:110].replace('\n',' '))
