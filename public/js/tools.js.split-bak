        getCategoryList: function(chatId) {
            var cid = chatId || this.currentChatId;
            var curCat = this.chatCategories[cid] || this.activeCategory;
            var list = [];
            for (var k in this.categories) {
                if (this.categories.hasOwnProperty(k)) {
                    list.push({
                        name: k,
                        icon: this.categories[k].icon,
                        desc: this.categories[k].desc,
                        active: k === curCat
                    });
                }
            }
            return list;
        },

        // ===== 切换分类 =====
        setCategory: function(name, chatId) {
            if (this.categories[name]) {
                this.activeCategory = name;
                var cid = chatId || this.currentChatId;
                if (cid) { this.chatCategories[cid] = name; }
                return true;
            }
            return false;
        },


