                            target_length: { type: 'string', description: '总结长度：极短、短、中、长，或具体字数' },
                            focus: { type: 'string', description: '总结重点，例如 结论、风险、行动项、关键数据' }
                        },
                        required: []
                    }
                }
            },
            write_outline: {
                type: 'function',
