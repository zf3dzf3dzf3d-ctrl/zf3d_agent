                            path: { type: 'string', description: '可选：文本文件路径' },
                            format: { type: 'string', description: '输出格式：Markdown、编号、缩进' },
                            detail_level: { type: 'string', description: '详细程度：粗略、标准、详细' }
                        },
                        required: []
