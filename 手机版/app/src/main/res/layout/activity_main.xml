<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <!-- 内容区（全屏）：右上角浮空「⋯更多」按钮，其余入口全部收进更多菜单，不再占据顶部一排 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview_remote"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <WebView
            android:id="@+id/webview_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/browser_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#161B22"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <EditText
                    android:id="@+id/url_input"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="#0D1117"
                    android:hint="输入网址"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#556677"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_close_browser"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:text="✕"
                    android:textColor="#8899AA"
                    android:textSize="16sp" />
            </LinearLayout>

            <WebView
                android:id="@+id/webview_browser"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/splash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#101418"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="峰控"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="正在连接智能体…"
                android:textColor="#8899AA"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 「⋯更多」按钮：v81 移到左上角（原右上角与工具面板关闭按钮重叠导致面板无法关闭）。
             工具执行计数徽标贴其右上角，仿桌面版三点菜单明面徽章，由 ZFUI.setToolCount 驱动 +1 弹跳动画。 -->
        <FrameLayout
            android:id="@+id/tab_more_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginTop="6dp"
            android:layout_marginStart="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <Button
                android:id="@+id/tab_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:text="⋯"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tab_tools_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:background="@drawable/tab_tools_badge_bg"
                android:minWidth="16dp"
                android:minHeight="16dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
