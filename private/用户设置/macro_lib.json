{
  "三师流水线": {
    "name": "三师流水线",
    "desc": "一键创建策划师+审核师+总结师三对话并派发任务，参数：${话题}",
    "steps": [
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是策划师。请针对以下话题输出策划方案：${话题}",
          "auto_send": true,
          "x": 100,
          "y": 100
        }
      },
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是审核师。请对策划方案严格审核，输出通过/打回意见。话题：${话题}",
          "auto_send": true,
          "x": 400,
          "y": 100
        }
      },
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是总结师。请汇总策划方案与审核意见，输出最终总结报告。话题：${话题}",
          "auto_send": true,
          "x": 700,
          "y": 100
        }
      }
    ],
    "updated": "2026-02-14 00:00:00"
  },
  "审核师": {
    "name": "审核师",
    "desc": "新建审核师对话做独立核验式审核，参数：${审核对象或话题}",
    "steps": [
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是审核师。请对以下对象进行独立核验式审核（逐条对照、自我反驳、问题定位、通过/不通过结论与评分）：${审核对象或话题}",
          "auto_send": true,
          "x": 100,
          "y": 400
        }
      }
    ],
    "updated": "2026-02-14 00:00:00"
  },
  "总结师": {
    "name": "总结师",
    "desc": "新建总结师对话做结构化总结，参数：${总结对象或话题}",
    "steps": [
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是总结师。请对以下内容做结构化总结（要点、结论、遗留事项）：${总结对象或话题}",
          "auto_send": true,
          "x": 100,
          "y": 700
        }
      }
    ],
    "updated": "2026-02-14 00:00:00"
  },
  "策划师": {
    "name": "策划师",
    "desc": "新建策划师对话产出策划方案，参数：${策划话题}",
    "steps": [
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是策划师。请针对以下话题输出可执行策划方案（目标、步骤、产出、验收）：${策划话题}",
          "auto_send": true,
          "x": 100,
          "y": 1000
        }
      }
    ],
    "updated": "2026-02-14 00:00:00"
  },
  "四师流水线": {
    "name": "四师流水线",
    "desc": "一键创建策划师+审核师+总结师+验证师四对话并派发任务（终验只看结果是否符合用户预期），参数：${话题}",
    "steps": [
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是策划师。请针对以下话题输出策划方案：${话题}",
          "auto_send": true,
          "x": 100,
          "y": 100
        }
      },
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是审核师。请对策划方案严格审核，输出通过/打回意见。话题：${话题}",
          "auto_send": true,
          "x": 400,
          "y": 100
        }
      },
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是总结师。请汇总策划方案与审核意见，输出最终总结报告。话题：${话题}",
          "auto_send": true,
          "x": 700,
          "y": 100
        }
      },
      {
        "use": "chat_manage",
        "args": {
          "action": "create",
          "message": "你是验证师（终验官）。请对最终结果做终验：只比对用户原始问题预期与最终交付结果，逐条输出 ✅/❌/⚠️ 对照表与 可交付/不可交付 结论，不评审中途过程。话题：${话题}；无法实测时仅做文本比对并标注⚠️未实测。",
          "auto_send": true,
          "x": 1000,
          "y": 100
        }
      }
    ],
    "updated": "2026-10-27 06:30:00"
  }
