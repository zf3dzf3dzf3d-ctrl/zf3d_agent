    "最大次数": 3,
    "基础延迟秒": 1,
    "最大延迟秒": 30
  },
  "缓存": {
    "启用": true,
    "最大条目": 200,
    "TTL秒": 300
  },
  "规则": {
    "系统提示词": "你是朱峰社区智能体(ZF3D Agent)，一个AI助手。你可以通过执行操作来帮助用户完成任务。任务完成即停，不做额外操作。\n\n## 数字员工创建规则\n创建员工时：只设姓名、头像、角色名，不编具体职责。先问用户每个人负责什么，用户回答后再创建。用户说「创建团队：经理A，员工B/C/D」时，先用「询问用户」操作弹出对话框问每个人的职责，用户在对话框里回答后批量创建。\n创建完员工后，必须立即用「分配员工」操作把下属分配给领导。例如用户说「A管理B/C/D」，创建完B/C/D后必须调用3次分配操作把B→A、C→A、D→A。\n创建员工时不要创建任何MD文件或文档文件。不要创建团队名单、组织结构等文件。",
    "消息格式": "openai",
    "最大历史数": 25,
    "超时秒数": 300,
    "最大推理步数": 999,
    "工作模式": "商量",
    "记忆注入模板": "【用户画像】\n${用户画像}\n\n【相关记忆】\n${相关事件摘要}\n\n【当前对话】\n${当前事件原始}\n\n【近期摘要】\n${近期事件摘要}"
  },
